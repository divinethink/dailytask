rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // owner-তালিকায় বর্তমান uid আছে কিনা(তালিকা সবসময় non-empty: googleUid বা sentinel)।
    function isUnownedOrMineArray(uids) {
      return uids.hasAny([request.auth.uid]);
    }

    // --- Phase C prep: families/<familyId>/entries|weekly এর জন্য owner
    // lookup (currentMemberOwner()-এর নতুন-subcollection সংস্করণ) ---
    // ডকুমেন্ট আইডি কনভেনশন: "<memberId>_<date>" / "<memberId>_<yyyy-mm>"
    // (Technical Design Document অনুযায়ী; colon-এর বদলে underscore, কারণ
    // memberId নিজে hyphen ব্যবহার করে কিন্তু underscore নয় — তাই প্রথম
    // "_"-এ split করলে memberId নিরাপদে আলাদা হয়ে যায়)। এই মুহূর্তে কোনো
    // app code এই path পড়ে/লেখে না — শুধু future migration-এর জন্য rules
    // আগে থেকে প্রস্তুত রাখা হচ্ছে।
    //
    // Phase-5 ধাপ ২-৩: member-এর একমাত্র owner = তার googleUid। ownerUids/ownerUid
    // আর পড়া হয় না। member ডক না থাকলে, googleUid না থাকলে বা null হলে কখনো-না-মেলা
    // sentinel রিটার্ন হয় — তাই শুধু admin(isAdminOfFamily OR-clause) লিখতে পারে;
    // null/ফাঁকা array কখনো রিটার্ন হয় না(open-write হোল নয়)।
    function currentMemberOwnerV2(familyId, docId) {
      let memberId = docId.split('_')[0];
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(memberId);
      let m = exists(memberPath) ? get(memberPath).data : null;
      return (m != null && ('googleUid' in m) && m.googleUid != null) ? [m.googleUid]
        : ['__unclaimed_no_owner__'];
    }

    // memberId জানা থাকলে সরাসরি owner-তালিকা: শুধু googleUid(claimed হলে), নইলে []।
    function memberOwnerUids(familyId, memberId) {
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(memberId);
      let m = exists(memberPath) ? get(memberPath).data : null;
      return (m != null && ('googleUid' in m) && m.googleUid != null) ? [m.googleUid] : [];
    }

    // --- Phase C: Admin-bypass (শুধু bulk migration-এর জন্য) ---
    // request.auth.uid যদি families/<familyId>-এর adminUids array-তে থাকে,
    // তাহলে সেই ব্যক্তি migration/Copy ধাপে ownerUid-নির্বিশেষে members/
    // entries/weekly-তে লিখতে পারবে। এটি *শুধু* Admin-এর জন্য অতিরিক্ত
    // permission — সাধারণ (non-Admin) ব্যবহারকারীর জন্য বিদ্যমান
    // isUnownedOrMine()-ভিত্তিক per-owner write-lock সম্পূর্ণ অপরিবর্তিত
    // থাকছে (নিচের rules-এ isUnownedOrMine(...) || isAdminOfFamily(...)
    // — দুটোর যেকোনো একটা true হলেই যথেষ্ট)।
    function isAdminOfFamily(familyId) {
      let familyPath = /databases/$(database)/documents/families/$(familyId);
      return exists(familyPath)
        && get(familyPath).data.adminUids.hasAny([request.auth.uid]);
    }

    // --- Access Approval Gate — Step 3: read enforcement (v2 only) ---
    // Admin সবসময় approved (isAdminOfFamily)। Non-admin-এর জন্য
    // families/{familyId}/accessRequests/{uid}.status == "approved" লাগবে —
    // এটা grandfather migration script (migrateApprovedGrandfatherAccess())
    // দিয়ে backfill করা হয় অথবা ভবিষ্যতে admin approve করলে তৈরি হয়।
    // ইচ্ছাকৃতভাবে শুধু v2 (families/{familyId}/members|entries|weekly)
    // subcollection-এ প্রয়োগ করা হচ্ছে — legacy top-level data_<code>
    // collection এখনো touch করা হয়নি (আলাদা approval লাগবে)।
    // --- §Google-Login Identity Migration(2_4 §৯, list-access) ---
    // isApprovedMember()-এ নতুন googleUid-claimed সদস্যদের জন্য additive OR
    // যোগ করার helper। Trust anchor member-doc-এর নিজস্ব googleUid field
    // (isClaimedByGoogle, উপরে সংজ্ঞায়িত) — users/{uid} doc নিজে
    // self-writable(forge-যোগ্য) বলে শুধু route-hint হিসেবে ব্যবহার হয়,
    // চূড়ান্ত সত্যতা সবসময় member-doc থেকেই cross-verify হয়।
    function isClaimedFamilyMember(familyId) {
      let uPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(uPath)
        && get(uPath).data.familyId == familyId
        && isClaimedByGoogle(familyId, get(uPath).data.memberId);
    }

    function isApprovedMember(familyId) {
      // Phase-5: accessRequests-ভিত্তিক approval সরানো হয়েছে।
      return isAdminOfFamily(familyId)
        || isAppCreator()
        || isClaimedFamilyMember(familyId);
    }

    // --- §Google-Login Identity Migration(2_4/2_4_1, dual-path, transitioning) ---
    // সম্পূর্ণ additive — বিদ্যমান ownerUids/Member-Password-ভিত্তিক কোনো
    // rule/function স্পর্শ করা হয়নি। শুধু নতুন googleUid-ভিত্তিক দাবির
    // জন্য একটা helper: এই memberId-তে request.auth.uid ঠিক তার
    // claimed googleUid হিসেবে match করে কিনা।
    function isClaimedByGoogle(familyId, memberId) {
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(memberId);
      return exists(memberPath)
        && ('googleUid' in get(memberPath).data)
        && get(memberPath).data.googleUid == request.auth.uid;
    }

    // --- App creator-only delete permission (স্থায়ী) ---
    // এই ক্ষমতা কোনো family-র adminUids-এর সাথে কখনো coupled না — এটা
    // family-membership থেকে সম্পূর্ণ স্বাধীন, app-wide, single-uid-ভিত্তিক
    // permission। কোনো family admin (যত বড় family-র হোক) এই তিনটা
    // metadata collection-এ কখনো delete করতে পারবে না — শুধু এই uid।
    function isAppCreator() {
      return request.auth.uid == "yiirNJKJHlM27guiiS10zsp2FYT2";
    }

    // ============================================================
    // §Public Tools — Phase E(ব্লগ)/F(কুইজ)/G(Editable Content)
    // ============================================================
    // তিনটাই family-Firestore(families/{familyId}/..., data_<code>) থেকে
    // সম্পূর্ণ independent, নতুন top-level collection — উপরের/নিচের কোনো
    // বিদ্যমান match-block স্পর্শ করা হয়নি(সম্পূর্ণ additive)। isAppCreator()
    // ছাড়া বাকি সব(isBlogWriter() ও এই তিনটা match-block) নতুন।
    // সহায়ক ফাইল: 3_4_Blog_Feature_Plan.md §৩, 3_5_Quiz_Feature_Plan.md §৩,
    // 3_6_Editable_Content_Plan.md §৩।

    // --- Phase E: ব্লগ(multi-writer, owner-curated) ---
    function isBlogWriter() {
      return request.auth.token.email is string
        && exists(/databases/$(database)/documents/blogWriters/$(request.auth.token.email.lower()));
    }

    match /blogWriters/{emailKey} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isAppCreator();
      allow update: if false;
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && isBlogWriter()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid || isAppCreator());
    }

    // --- Phase F: কুইজ(single-owner — App Creator-only, ব্লগের চেয়ে সরল) ---
    match /quizQuestions/{questionId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAppCreator();
    }

    // --- Phase G: Editable Content(single-owner — App Creator-only) ---
    match /publicToolsContent/{sectionId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAppCreator();
    }

    // --- users/{uid}: Google-linked uid <-> familyCode mapping ---
    // শুধুমাত্র নিজ uid-এর ডকুমেন্ট নিজে read/write করতে পারবে। এটি কোনো
    // family/member ডাটা নয় — শুধু account-ভিত্তিক recovery mapping।
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- §Google-Login Identity Migration(2_4 §3/§10.2): familyMemberEmails ---
    // Uniqueness-enforcing collection: doc-id = normalizeEmail(email)(trim+
    // lowercase, 2_4 §১০.২ — client এই একই normalization প্রয়োগ করেই doc-id
    // বানাবে, Rules নিজে normalize করে না, শুধু shape/uniqueness নিশ্চিত করে)।
    // { familyId, memberId } — reverse-cleanup(family-leave)-এর জন্য
    // composite(familyId+memberId) index client-side দরকার, Rules-এ প্রভাব
    // নেই।
    match /familyMemberEmails/{emailKey} {
      // get: doc-id জানা থাকলে(email-match লগইন চেষ্টার সময়) যেকোনো
      // authenticated user existence+টার্গেট familyId/memberId দেখতে পারবে
      // — এটা email নিজে exposed করে না(doc-id already client-known), শুধু
      // routing তথ্য। list বন্ধ(পুরো email-directory enumeration প্রতিরোধ)।
      allow get: if request.auth != null;
      allow list: if false;
      // create — দুই বৈধ পথ, দুটোতেই doc-id(emailKey) 2_4 §১০.২-এর
      // normalizeEmail()-এর সাথে explicitly cross-verified(আগে শুধু
      // client-discipline-নির্ভর ছিল, এখন Rules-level enforced)। Critical
      // #2 fix(claim-update clause)-এর একই কনভেনশন অনুসরণ করে শুধু
      // .lower() ব্যবহার হয়েছে(trim দরকার নেই — Google account email-এ
      // leading/trailing space থাকে না):
      //   (ক) claimed-self(googleUid==request.auth.uid ঠিক সেই memberId-এ)
      //       — emailKey অবশ্যই Firebase Auth-এর server-verified
      //       token-email(request.auth.token.email, client দাবির উপর না)
      //       এর normalize-করা রূপের সমান হতে হবে।
      //   (খ) admin(proxy member যোগ করার সময়, একই batch-এ member.email
      //       set হচ্ছে) — getAfter() দিয়ে সেই memberId-এর পোস্ট-transaction
      //       email field পড়ে emailKey-এর সাথে মেলানো হয়(member.email
      //       ইতিমধ্যে normalizeEmail()-প্রয়োগ করা থাকে, §১০.২)।
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['familyId', 'memberId'])
        && request.resource.data.familyId is string
        && request.resource.data.memberId is string
        && (
             (isClaimedByGoogle(request.resource.data.familyId, request.resource.data.memberId)
               && request.auth.token.email is string
               && emailKey == request.auth.token.email.lower())
             || (isAdminOfFamily(request.resource.data.familyId)
               && emailKey == getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(request.resource.data.memberId)).data.email)
           );
      allow update: if false;
      // delete: family-leave/remove(§৫.৩) — admin অথবা নিজে(claimed
      // owner) — mapping doc-এর familyId/memberId দিয়েই সংশ্লিষ্ট family
      // যাচাই হয়(resource.data ব্যবহার, request না — delete-এ
      // request.resource থাকে না)।
      // §Cross-family stale-mapping fix(১৪ সেপ্টেম্বর ২০২৬, owner-reported):
      // আগে শুধু isAdminOfFamily(resource.data.familyId)(mapping যে family-র,
      // সেই family-র admin) অথবা isClaimedByGoogle() দিয়েই delete অনুমোদিত
      // ছিল — admin কাউকে remove করলে(claimed member, email field ততক্ষণে
      // claim-মুহূর্তেই মুছে গেছে বলে admin জানেনই না) এই mapping doc dangling
      // থেকে যেত, এবং সেই email দিয়ে **অন্য** family-তে admin proxy-member
      // যোগ করতে গেলে(addProxyMemberByAdmin()) block হতো(admin সেই পুরনো
      // family-র admin না বলে delete করতে পারতেন না)। নতুন orphan-check:
      // resource-এ উল্লিখিত familyId/memberId-এ member doc সত্যিই আর
      // বিদ্যমান না থাকলে(exists()==false, অর্থাৎ mapping সত্যিকারের dead/
      // orphaned), যেকোনো authenticated user সেটা delete করতে পারবে —
      // কোনো লাইভ/active mapping এতে touch হয় না(exists()==true হলে এই
      // arm সবসময় false, পুরনো দুই শর্তই তখনো একমাত্র পথ), তাই কোনো নতুন
      // security-surface তৈরি হয় না — শুধু dead-index self-heal সহজ হলো।
      allow delete: if request.auth != null
        && (
             isAdminOfFamily(resource.data.familyId)
             || isClaimedByGoogle(resource.data.familyId, resource.data.memberId)
             || !exists(/databases/$(database)/documents/families/$(resource.data.familyId)/members/$(resource.data.memberId))
           );
    }

    // --- Phase A (Family ID Foundation) prep: familyCode -> familyId lookup ---
    // শুধু প্রস্তুতিমূলক, additive collection — বিদ্যমান data_<familyCode>
    // rules/logic এর কোনো অংশ বদলানো হয়নি। এই মুহূর্তে app শুধু create করে
    // (একবারই, ensureFamilyCodeMapping()); update/delete এই Phase-এ বন্ধ
    // রাখা হলো, কারণ Family Code migration (Phase D) এখনো implement হয়নি।
    match /familyCodes/{code} {
      // Audit-fix(enumeration, ১৫ আগস্ট ২০২৬): আগে `allow read` (get+list
      // দুটোই কভার করে) থাকায় যেকোনো authenticated user পুরো collection
      // list করে সব family code দেখতে পারত। app.js grep-verify করে
      // নিশ্চিত হওয়া গেছে যে কোনো collection-wide query ব্যবহৃত হয় না
      // (শুধু .doc(code).get()) — তাই get আলাদা রেখে list বন্ধ করা হলো,
      // existing lookup আচরণ অক্ষুণ্ণ।
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['familyId', 'createdAt'])
        && request.resource.data.familyId is string
        && request.resource.data.familyId.size() > 0;
      allow update: if false;
      // §Fix(২১ আগস্ট ২০২৬, Family Username): আগে শুধু isAppCreator() delete
      // করতে পারত, কিন্তু changeFamilyCodeForExistingFamily() স্বাভাবিক
      // family admin দ্বারা পুরনো mapping doc (normalized+raw) delete করে —
      // ফলে rename permission-denied দিয়ে fail করত। Fix: resource.data.familyId
      // -এর admin হলেও delete অনুমোদিত (isAppCreator() ফলব্যাক হিসেবে থাকল)।
      // §Fix-২(২১ আগস্ট ২০২৬): app.js dual-delete চেষ্টা করে normalized-key ও
      // raw oldCode উভয় doc-id-তে — কিন্তু normalized-key doc যদি এই family-র
      // জন্য কখনো তৈরিই না হয়ে থাকে (প্রথমবার rename), তাহলে non-existent doc
      // delete-এ resource == null হয়, আর resource.data অ্যাক্সেস error ছুঁড়ে পুরো
      // transaction deny করে দিত। resource == null (no-op delete, harmless)
      // ক্ষেত্রে আলাদাভাবে allow করা হলো।
      allow delete: if request.auth != null
        && (resource == null || isAppCreator() || isAdminOfFamily(resource.data.familyId));
    }

    // --- legacyCollectionMap/{collectionName}: data_<code> কালেকশন থেকে
    // familyId-এ reverse lookup (copyPhaseCData()-এর guard, ও
    // healthCheckFamily()/auditAllFamiliesHealthCheck()-এর consistency
    // check এখান থেকেই পড়ে; আজকের rollback fix-এও isLegacyRollbackBypass()
    // এই একই collection থেকে familyId lookup করে)। আগে এই match ব্লক
    // rules ফাইলে ছিল না বলে Firestore default-deny করছিল —
    // "Missing or insufficient permissions" এর root cause এটাই। setOnce
    // pattern: create শুধু একবারই (doc আগে থেকে না থাকলে), update/delete
    // বন্ধ — ভুল entry হলে শুধু owner Firebase Console থেকে ম্যানুয়ালি
    // ঠিক করবেন, client থেকে সম্ভব না (ইচ্ছাকৃত, owner-approved)।
    match /legacyCollectionMap/{collectionName} {
      // Audit-fix(enumeration, ১৫ আগস্ট ২০২৬): familyCodes-এর মতো একই
      // কারণে — app.js grep-verify করে নিশ্চিত (শুধু .doc(name).get()/
      // isApprovedLegacyMember()-এর ভেতরের get(), কোনো collection-query
      // নেই) — get আলাদা রেখে list বন্ধ।
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['familyId', 'createdAt'])
        && request.resource.data.familyId is string
        && request.resource.data.familyId.size() > 0;
      allow update: if false;
      allow delete: if request.auth != null && isAppCreator();
    }

    // --- Phase A-2: families/{familyId} root/meta ডকুমেন্ট ---
    // এই মুহূর্তে শুধু background prep — কোনো live UI feature এখনো এর ওপর
    // নির্ভর করে না। "প্রথম Admin" নিয়ম এখানেই server-side enforce করা
    // হচ্ছে (শুধু client-side check নয়): adminUids একবার ফাঁকা থেকে
    // ফাঁকা-নয় হতে পারবে, শুধু তখনই যদি নতুন array-তে ঠিক request করা uid
    // থাকে — এভাবে দুইজন প্রায় একইসাথে claim করার চেষ্টা করলেও (race
    // condition) Firestore-এর atomic write guarantee-র কারণে মাত্র
    // একজনই সফল হবে, দ্বিতীয়জনের request reject হবে (rules পুনরায় নতুন
    // state দেখে দ্বিতীয়বার true হবে না)।
    match /families/{familyId} {
      // Audit-fix(Critical #1) — RE-ENABLED(১৫ আগস্ট ২০২৬) + PERFORMANCE FIX
      // (একই দিন, পারফরম্যান্স রিগ্রেশনের পর): আগে এখানে isApprovedMember()
      // ব্যবহার হতো, যেটা ভেতরে isAdminOfFamily() কল করে get(familyPath)
      // দিয়ে এই *একই* ডকুমেন্ট আবার fetch করত (redundant self-read) —
      // প্রতিটি listen/read-এ অতিরিক্ত round-trip, ফলে load time ২০-৩০
      // সেকেন্ড পর্যন্ত বেড়ে যায় (spouse-এর ডিভাইসে observed)। Fix: admin
      // check-এ get() না করে সরাসরি resource.data (already available,
      // extra read লাগে না) ব্যবহার করা হলো। Security logic অভিন্ন — শুধু
      // redundant read বাদ। accessRequests lookup (non-admin approval)-এর
      // জন্য এক get() লাগবেই, সেটা অপরিবর্তিত।
      // single-doc get: শুধু authenticated; list নিচের শর্তে গেটেড। family-root doc-এ কোনো secret নেই।
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && (
             resource.data.adminUids.hasAny([request.auth.uid])
             || isAppCreator()
           );
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['familyId', 'familyCode', 'isCustomCode', 'createdAt',
              'createdByUid', 'schemaVersion', 'adminUids', 'dataCollectionName',
              'migrationState'])
        // §English-only validation(২৩ আগস্ট ২০২৬, owner-approved): আগে
        // creation-এ familyCode-এর নিজস্ব charset/length সরাসরি চেক হতো না
        // (শুধু dataCollectionName দেওয়া হলে পরোক্ষভাবে বাঁধা পড়ত) — এখন
        // client-side FAMILY_CODE_CHARSET_PATTERN/MIN/MAX-LENGTH-এর সাথে
        // সামঞ্জস্যপূর্ণ সরাসরি চেক যোগ করা হয়েছে(নিচের rename clause-এর
        // regex-এর সাথেই মিল)।
        && request.resource.data.familyCode is string
        && request.resource.data.familyCode.matches('^[A-Za-z0-9_-]{6,30}$')
        // বাগ-ফিক্স(২৭.৩): createNewFamily() এখন creation-এই migrationState
        // পাঠায়(নইলে joinExistingFamily() field-না-থাকা অবস্থায় "legacy"
        // ধরে ব্লক করে দিত) — দেওয়া হলে অবশ্যই "v2" হতে হবে, অন্য কোনো মান
        // দিয়ে forge করা যাবে না।
        && (!('migrationState' in request.resource.data)
            || request.resource.data.migrationState == 'v2')
        && request.resource.data.adminUids == []
        // §৫ fix: dataCollectionName ঐচ্ছিক নয় বলে জোর করা হয়নি (পুরনো
        // client version সাময়িক সময়ের জন্য এই field ছাড়াই create করতে
        // পারে), তবে দেওয়া হলে অবশ্যই ঠিক familyCode থেকে deterministic-ভাবে
        // derive করা হতে হবে — forge করে ভিন্ন কোনো কালেকশনে redirect করা
        // যাবে না।
        && (!('dataCollectionName' in request.resource.data)
            || request.resource.data.dataCollectionName == 'data_' + request.resource.data.familyCode);
      // §First Admin Protection — claim-মুহূর্তেই firstAdminUid একবার সেট
      // হয়(immutable — এই clause শুধু adminUids শূন্য থেকে অ-শূন্য হওয়ার
      // সময়েই fire করে, তাই দ্বিতীয়বার আর কখনো ছোঁয়া যায় না)। নিচের
      // Remove-Admin clause এই field ব্যবহার করে প্রথম Admin-কে অন্যদের
      // দ্বারা বাদ পড়া থেকে রক্ষা করে।
      allow update: if request.auth != null
        && resource.data.adminUids.size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids', 'firstAdminUid', 'updatedAt'])
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.firstAdminUid == request.auth.uid;
      // §First Admin Protection — one-time backfill (backfillFirstAdminUid()):
      // বিদ্যমান family(adminUids already non-empty)-তে firstAdminUid না
      // থাকলে, বর্তমান কোনো admin একবার নিজেকে(বা অন্য কোনো বিদ্যমান
      // admin-কে) firstAdminUid হিসেবে সেট করতে পারবেন। একবার সেট হলে এই
      // clause আর কখনো match করবে না (immutable-once-set)।
      allow update: if request.auth != null
        && resource.data.adminUids.hasAny([request.auth.uid])
        && !('firstAdminUid' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstAdminUid', 'updatedAt'])
        && resource.data.adminUids.hasAny([request.resource.data.firstAdminUid]);
      // §৫ fix — dataCollectionName one-time backfill (ensureDataCollectionName()):
      // শুধু তখনই অনুমতি যখন এই field আগে থেকে ছিলই না (একবার সেট হলে আর
      // কখনো এই clause দিয়ে বদলানো যাবে না — immutable-once-set) এবং নতুন
      // মান অবশ্যই resource-এর *বর্তমান* familyCode থেকে deterministic-ভাবে
      // derive করা হতে হবে (forge করে অন্য কালেকশনে redirect করা অসম্ভব)।
      allow update: if request.auth != null
        && !('dataCollectionName' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dataCollectionName', 'updatedAt'])
        && request.resource.data.dataCollectionName == 'data_' + resource.data.familyCode;
      // §৫ fix — controlled familyCode change (changeFamilyCodeForExistingFamily()):
      // শুধু বিদ্যমান Admin-রা পারবেন, শুধু familyCode+updatedAt affected
      // হতে পারবে (dataCollectionName এই clause দিয়ে কখনো বদলানো যায় না —
      // তাই আসল ডাটা কালেকশন সবসময় অপরিবর্তিত থাকে), এবং নতুন কোড
      // client-side চার্সেট/দৈর্ঘ্যের সাথে সামঞ্জস্যপূর্ণ হতে হবে।
      // §Item(২১ আগস্ট ২০২৬): min-length ৯→৬ (client FAMILY_CODE_MIN_LENGTH-এর
      // সাথে সমন্বয়ে, isAppCollection()-এর সাথেও মিল রাখা হয়েছে)।
      // §English-only validation(২৩ আগস্ট ২০২৬, owner-approved): charset
      // English letter/digit/underscore/hyphen-এ সংকুচিত, creation-rule ও
      // isAppCollection()-এর regex-এর সাথে সামঞ্জস্যপূর্ণ।
      allow update: if request.auth != null
        && resource.data.adminUids.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyCode', 'updatedAt'])
        && request.resource.data.familyCode is string
        && request.resource.data.familyCode.matches('^[A-Za-z0-9_-]{6,30}$');
      allow delete: if request.auth != null && isAppCreator();

      // §Admin Visibility UI — Make Admin (add): বিদ্যমান admin-ই শুধু
      // আরেকজনকে admin করতে পারবে। নতুন adminUids অবশ্যই পুরনো array-কে
      // সম্পূর্ণ ধরে রাখবে (hasAll)। §Multi-device: একজন member-এর সব
      // ownerUids(max 3) একসাথে admin করা যায়, তাই ১-৩টা নতুন uid যোগ
      // অনুমোদিত(কোনো বিদ্যমান uid সরানো এই clause দিয়ে সম্ভব না)।
      allow update: if request.auth != null
        && resource.data.adminUids.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids', 'updatedAt'])
        && request.resource.data.adminUids.hasAll(resource.data.adminUids)
        && request.resource.data.adminUids.size() > resource.data.adminUids.size()
        && request.resource.data.adminUids.size() <= resource.data.adminUids.size() + 3;

      // §Admin Visibility UI — Remove Admin (demote, নিজেকে বা অন্য
      // admin-কে): বিদ্যমান admin-ই শুধু পারবে। নতুন adminUids অবশ্যই
      // পুরনো array-এর subset হবে (কোনো নতুন uid যোগ করা যাবে না)।
      // §Multi-device: একজন member-এর সব ownerUids(max 3) একসাথে বাদ
      // দেওয়া যায়, তাই ১-৩টা uid কমা অনুমোদিত, আর ফলাফলে অন্তত ১ জন
      // admin অবশিষ্ট থাকতে হবে (কখনো পুরো family admin-হীন হয়ে lockout
      // হবে না)।
      // §First Admin Protection(নতুন শর্ত): resource.data-এ firstAdminUid
      // ট্র্যাক করা থাকলে, সেই uid নতুন array থেকে বাদ পড়তে পারবে শুধু
      // তখনই যখন requester নিজেই firstAdminUid(অর্থাৎ শুধু নিজেকে নিজে
      // demote করা যায়, অন্য কোনো admin firstAdminUid-কে বাদ দিতে পারবে
      // না)। পুরনো family(firstAdminUid field নেই)-এ এই শর্ত স্বয়ংক্রিয়ভাবে
      // bypass হয় — backward-compatible, backfill না হওয়া পর্যন্ত আগের
      // আচরণ অপরিবর্তিত থাকে।
      allow update: if request.auth != null
        && resource.data.adminUids.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids', 'updatedAt'])
        && resource.data.adminUids.hasAll(request.resource.data.adminUids)
        && request.resource.data.adminUids.size() < resource.data.adminUids.size()
        && request.resource.data.adminUids.size() >= resource.data.adminUids.size() - 3
        && request.resource.data.adminUids.size() >= 1
        && (!('firstAdminUid' in resource.data)
            || request.resource.data.adminUids.hasAny([resource.data.firstAdminUid])
            || request.auth.uid == resource.data.firstAdminUid);

      // §Recovery Key — key জানা যেকোনো authenticated user নিজেকে
      // adminUids-এ যোগ করতে পারবে, শুধু যদি সঠিক hash পাঠায়(client নিজেই
      // entered key hash করে পাঠায় — plaintext কখনো Firestore-এ যায় না)।
      // hidden private/recovery doc-এর সাথে get() দিয়ে compare। Rules
      // all-or-nothing গেট — hash না মিললে পুরো write-ই reject হয়(কিছুই
      // persist হয় না), তাই ভুল guess-এর কোনো ছাপ document-এ থাকে না।
      // adminUids শুধু পুরনো array + ঠিক নিজের uid যোগ হতে পারবে(অন্য
      // কিছু বদলানো/সরানো যাবে না)।
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/families/$(familyId)/private/recovery)
        && request.resource.data.recoveryHashAttempt
             == get(/databases/$(database)/documents/families/$(familyId)/private/recovery).data.hash
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids', 'recoveryHashAttempt', 'updatedAt'])
        && request.resource.data.adminUids.hasAll(resource.data.adminUids)
        && request.resource.data.adminUids.size() == resource.data.adminUids.size() + 1
        && request.resource.data.adminUids.hasAny([request.auth.uid]);

      // §Phase E prep — lastActiveAt stamp (scope-সীমিত, revised):
      // Data Lifecycle Policy-এর জন্য family-level activity stamp। এই write
      // stampLastActive() থেকে member/entry write-এর *একই atomic batch*-এ
      // bundled হয় (app.js) — Firestore batch all-or-nothing, তাই এই
      // clause-এর permission member/entry write-rule-এর সাথে সামঞ্জস্যপূর্ণ
      // হতে হবে, নাহলে unapproved/unclaimed member-এর বৈধ save-ও পুরোপুরি
      // fail করবে। member/entry write rule-এ isApprovedMember() লাগে না
      // (শুধু ownership) — তাই এখানেও isApprovedMember বাদ দেওয়া হলো;
      // security boundary field-scope দিয়েই বজায় থাকছে (*শুধু* lastActiveAt
      // affected হতে পারবে, অন্য কোনো field না — পুরো family root doc নয়)।
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt']);

      // --- §Google-Login Identity Migration(2_4_1 §৩/§৫, dual-path) ---
      // সম্পূর্ণ additive, নতুন optional field-সেট। বিদ্যমান কোনো clause-এ
      // হাত দেওয়া হয়নি — legacy/v2-data-structure ownerUids-based path
      // অক্ষুণ্ণ থাকে যতক্ষণ না "google-only"।
      //
      // identityModel: "legacy"(default/absent) → "transitioning" →
      // "google-only"। শুধু admin, শুধু forward-direction, এক-ধাপ-এক-ধাপ
      // (skip করে সরাসরি legacy→google-only অনুমোদিত না — 2_4_1 §৫ Phase
      // order অনুযায়ী)।
      allow update: if request.auth != null
        && isAdminOfFamily(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['identityModel', 'updatedAt'])
        && (
             (!('identityModel' in resource.data) && request.resource.data.identityModel == 'transitioning')
             || (resource.data.identityModel == 'transitioning' && request.resource.data.identityModel == 'google-only')
           );

      // §Security-fix(৩ নভেম্বর ২০২৬): activeInviteToken আর এই root doc-এ
      // লেখা যাবে না(root doc যেকোনো signed-in user "get" করতে পারে →
      // token ফাঁস হতো)। নতুন জায়গা: নিচের inviteLinks/active(admin-only)।
      // এখানে শুধু পুরনো field মুছে ফেলার অনুমতি(admin, field-delete only)।
      allow update: if request.auth != null
        && isAdminOfFamily(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeInviteToken', 'updatedAt'])
        && !('activeInviteToken' in request.resource.data);

      // status/orphanedAt(soft-delete, 2_4 §৫.৪): system নিজে(শেষ সদস্য
      // leave/remove একই transaction-এ) সেট করে — সেই transaction-এর
      // acting uid পূর্বে ownerUids/googleUid দিয়ে verified-owner ছিল বলে
      // আলাদা admin-check এখানে না বসিয়ে শুধু field-scope+value-shape
      // দিয়ে সীমাবদ্ধ করা হলো(orphaned সেট হওয়ার মুহূর্তে family-তে আর কোনো
      // active admin নাও থাকতে পারে — isAdminOfFamily() তখন false হয়ে
      // legitimate soft-delete-ই ব্লক করে দিত)।
      allow update: if request.auth != null
        && !('status' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orphanedAt', 'updatedAt'])
        && request.resource.data.status == 'orphaned';
      // Grace-period পুনরুদ্ধার(৭ দিনের মধ্যে reactivate, admin/নতুন-join
      // দ্বারা) — শুধু status/orphanedAt field সরিয়ে দেওয়া(request.resource
      // -এ এই দুই key অনুপস্থিত থাকলেই যথেষ্ট, keys().hasOnly দিয়ে যাচাই
      // করা কঠিন কারণ absence-check — তাই diff().affectedKeys() ব্যবহার)।
      // নোট(client-implementation reminder, security-audit ৯ সেপ্টেম্বর
      // ২০২৬, Medium #3): এই clause ইচ্ছাকৃতভাবে admin-check ছাড়া রাখা
      // হয়েছে(orphaned family-তে active admin নাও থাকতে পারে) — কিন্তু
      // Invite-link join transaction(client, 2_4 §৫.২)-এ member-create-এর
      // সাথে এই status-removal write একই atomic batch-এ bundle করা
      // implementation-time-এ নিশ্চিত করতে হবে, নাহলে orphaned family
      // নতুন সদস্য join করার পরও stale-orphaned থেকে যেতে পারে এবং
      // manual TTL cleanup script grace-period-পরে ভুলবশত delete করে
      // ফেলতে পারে(rules-change লাগে না, শুধু client discipline)।
      allow update: if request.auth != null
        && 'status' in resource.data
        && resource.data.status == 'orphaned'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orphanedAt', 'updatedAt'])
        && !('status' in request.resource.data);

      // §Security-fix(৩ নভেম্বর ২০২৬): Invite token — শুধু admin পড়ে/লেখে।
      // Join-যাচাই members create-rule-এর ভেতরে get() দিয়ে হয়(সেটা এই
      // read-rule দ্বারা আটকায় না), তাই joiner নিজে token পড়তে পারে না।
      match /inviteLinks/{linkId} {
        allow get: if request.auth != null
          && linkId == 'active'
          && isAdminOfFamily(familyId);
        allow list: if false;
        allow create, update: if request.auth != null
          && linkId == 'active'
          && isAdminOfFamily(familyId)
          && request.resource.data.keys().hasOnly(['token', 'createdAt', 'revoked'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 22
          && request.resource.data.createdAt is number
          && request.resource.data.revoked is bool;
        allow delete: if false;
      }

      // --- Phase C prep: members/entries/weekly subcollection rules ---
      // পুরোপুরি additive ও এই মুহূর্তে অব্যবহৃত — কোনো app code এখনো এই
      // path পড়ে/লেখে না (app এখনো সম্পূর্ণভাবে data_<familyCode>-ই
      // ব্যবহার করছে)। বর্তমান top-level isUnownedOrMine()/isWritable()-এর
      // লজিক হুবহু পুনর্ব্যবহার করা হয়েছে, শুধু নতুন subcollection path-এর
      // জন্য মানানসই করে — যাতে Phase C-এর আসল migration script চালানোর
      // সময় rules নিয়ে আলাদা করে অপেক্ষা করতে না হয়।
      match /members/{memberId} {
        // single-doc get: শুধু authenticated; list (পুরো roster) isApprovedMember-গেটেড।
        allow get: if request.auth != null;
        allow list: if request.auth != null && isApprovedMember(familyId);

        // Admin সরাসরি member (proxy) তৈরি করতে পারেন।
        allow create: if request.auth != null && isAdminOfFamily(familyId);

        // §Google-Login — Invite-link self-join(2_4 §৫.২, additive):
        // Admin ছাড়াই নতুন সদস্য নিজে token-validated create করতে পারবেন,
        // শর্তে যে family-র activeInviteToken অবশ্যই আছে+revoked নয়+দেওয়া
        // token হুবহু মেলে, এবং সৃষ্ট doc-এ googleUid ঠিক নিজের uid(claimed
        // অবস্থাতেই তৈরি হয়, unclaimed-proxy আলাদা path §৫.১-এ)। role
        // client "member"-ছাড়া কিছু পাঠাতে পারবে না(privilege-escalation
        // guard — admin role এই path দিয়ে কখনো পাওয়া যাবে না)।
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/families/$(familyId)/inviteLinks/active)
          && get(/databases/$(database)/documents/families/$(familyId)/inviteLinks/active).data.revoked == false
          && 'inviteTokenAttempt' in request.resource.data
          && request.resource.data.inviteTokenAttempt
               == get(/databases/$(database)/documents/families/$(familyId)/inviteLinks/active).data.token
          && request.resource.data.googleUid == request.auth.uid
          && request.resource.data.role == 'member'
          && request.resource.data.keys().hasOnly(['name', 'gender', 'googleUid', 'role', 'inviteTokenAttempt', 'createdAt', 'updatedAt']);

        // বাগ-ফিক্স(২৭.৪): আগে isUnownedOrMine(...) থাকায় self-owner
        // নিজেও নিজের member delete করতে পারতো — শুধু Admin-ই member
        // delete করতে পারবে, এই নিয়ম প্রয়োগ করতে isUnownedOrMine বাদ।
        allow delete: if request.auth != null && isAdminOfFamily(familyId);

        // §Google-Login cutover-safe role-change(নতুন, additive): উপরের
        // legacy block google-only-তে বন্ধ হওয়ায় role field আলাদা,
        // narrow, ownerUids-নির্বিশেষে-সচল clause পাচ্ছে(Make/Remove
        // Admin — 2_4 §৮ "অপরিবর্তিত" নীতি অনুযায়ী legacy ও google-only
        // উভয় state-এই কাজ করবে)। শুধু role+updatedAt affected হতে পারবে।
        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']);

        // Activity-stamp: saveEntry()/saveWeekly()-এর একই atomic batch-এ member-doc-এ
        // {lastActiveAt, ownerActivity, updatedAt} merge-write হয় (memberData.js stampLastActive)।
        // এই clause না থাকলে batch-এর মূল entry/weekly write-ও ব্যর্থ হতো।
        // শুধু claimed সদস্য (googleUid == request.auth.uid), শুধু এই ৩টা ফিল্ড।
        allow update: if request.auth != null
          && isClaimedByGoogle(familyId, memberId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'ownerActivity', 'updatedAt']);

        // Admin-proxy activity-stamp: Admin যখন unclaimed proxy (googleUid অনুপস্থিত/null)-এর
        // হয়ে entry সেভ করেন, একই batch-এর member-doc stamp-ও অনুমোদিত হতে হবে —
        // নইলে পুরো batch ব্যর্থ হয়। শুধু unclaimed member, একই ৩টা ফিল্ড।
        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && (!('googleUid' in resource.data) || resource.data.googleUid == null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'ownerActivity', 'updatedAt']);

        // --- §Motivational Layer(নতুন, চ্যাট-approved plan, দুইটা clause) ---
        // দুটোই সম্পূর্ণ additive, saveEntry()/stampLastActive()-এর কোনো
        // clause স্পর্শ করা হয়নি(sensitive area — ১১ সেপ্টেম্বর ২০২৬-এর
        // lock-out ইনসিডেন্ট এই একই ধরনের member-doc write-path-এ হয়েছিল,
        // 2_4_1 §৫.১ দ্রষ্টব্য)। উভয় clause caller claimed member নিজে অথবা
        // admin(unclaimed proxy-র জন্য) — উপরের existing pattern-এরই reuse।

        // Phase 1.5 — bestScoreEver(denormalized "সর্বকালের সেরা দিন" score,
        // memberData.js: updateBestScoreIfNeeded(), best-effort/non-blocking,
        // saveEntry()-এর batch-এর অংশ না, সম্পূর্ণ আলাদা independent write)।
        // Monotonic guard: নতুন value পুরনো bestScoreEver-এর চেয়ে বেশি হতেই
        // হবে(কখনো কমতে পারবে না) — client bug/race-condition-এও পুরনো higher
        // score ভুলবশত overwrite হবে না।
        allow update: if request.auth != null
          && (isClaimedByGoogle(familyId, memberId) || isAdminOfFamily(familyId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bestScoreEver', 'updatedAt'])
          && request.resource.data.bestScoreEver is number
          && request.resource.data.bestScoreEver >= 0
          && request.resource.data.bestScoreEver <= 100
          && request.resource.data.bestScoreEver > (('bestScoreEver' in resource.data) ? resource.data.bestScoreEver : -1);

        // Phase 2 — tomorrowFocus(পরদিনের auto-suggested/manual-override
        // Focus field, memberData.js: saveTomorrowFocus(), explicit user-action
        // থেকে সরাসরি ট্রিগার হয়, saveEntry() batch-এর অংশ না)।
        allow update: if request.auth != null
          && (isClaimedByGoogle(familyId, memberId) || isAdminOfFamily(familyId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tomorrowFocus', 'updatedAt'])
          && request.resource.data.tomorrowFocus.keys().hasOnly(['fieldKey', 'targetDateKey', 'setAt', 'source'])
          && request.resource.data.tomorrowFocus.fieldKey is string
          && request.resource.data.tomorrowFocus.fieldKey.size() > 0
          && request.resource.data.tomorrowFocus.targetDateKey is string
          && request.resource.data.tomorrowFocus.source in ['auto', 'manual'];

        // Home layout(ধাপ ক, owner-approved) — সদস্যভিত্তিক হোম-কার্ডের ক্রম/দৃশ্যমানতা/ভাঁজ
        // (memberData.js: saveHomeLayout(), explicit user-action, saveEntry() batch-এর অংশ না)।
        // tomorrowFocus-clause-এর হুবহু একই caller-নিয়ম; শুধু homeLayout+updatedAt বদলাতে পারে,
        // ঠিক {entry, below} দুটো তালিকা(প্রতিটা সর্বোচ্চ ২০টি) — এর বাইরের কিছু অনুমোদিত নয়।
        allow update: if request.auth != null
          && (isClaimedByGoogle(familyId, memberId) || isAdminOfFamily(familyId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeLayout', 'updatedAt'])
          && request.resource.data.homeLayout.keys().hasOnly(['entry', 'below'])
          && request.resource.data.homeLayout.entry is list
          && request.resource.data.homeLayout.entry.size() <= 20
          && request.resource.data.homeLayout.below is list
          && request.resource.data.homeLayout.below.size() <= 20;

        // কাস্টম টাস্ক(সদস্যভিত্তিক, owner-approved) — member-ডকের ঐচ্ছিক customTasks: [{id,label,archived?}]।
        // homeLayout-clause-এর হুবহু একই caller-নিয়ম; শুধু customTasks+updatedAt বদলাতে পারে।
        // সক্রিয়+আর্কাইভ মিলিয়ে সর্বোচ্চ ৪০টি(client-এ সক্রিয় ২০টি সীমা)। আইটেমের গঠন rules-এ যাচাই হয় না
        // (list-iteration নেই) — client sanitize করে; এটা শুধু আকার-সীমা ও ফিল্ড-সীমা।
        allow update: if request.auth != null
          && (isClaimedByGoogle(familyId, memberId) || isAdminOfFamily(familyId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customTasks', 'updatedAt'])
          && request.resource.data.customTasks is list
          && request.resource.data.customTasks.size() <= 40;

        // নেভ-ট্যাব কাস্টমাইজ(সময়সূচি/আমল/সহায়িকা, owner-approved ২ নভেম্বর ২০২৬) — member-ডকের ঐচ্ছিক
        // tabLayout ম্যাপ(memberData.js: saveTabLayout(), explicit user-action, saveEntry() batch-এর অংশ না)।
        // homeLayout-clause-এর হুবহু একই caller-নিয়ম; শুধু tabLayout+updatedAt বদলাতে পারে, tabLayout-এর
        // কী শুধু এই ছয়টা(প্রতিটা id-তালিকা, সর্বোচ্চ ২০টি) — এর বাইরের কিছু অনুমোদিত নয়।
        allow update: if request.auth != null
          && (isClaimedByGoogle(familyId, memberId) || isAdminOfFamily(familyId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tabLayout', 'updatedAt'])
          && request.resource.data.tabLayout.keys().hasOnly(['prayerOrder', 'prayerHidden', 'amolOrder', 'amolHidden', 'toolsOrder', 'toolsHidden'])
          && request.resource.data.tabLayout.get('prayerOrder', []) is list
          && request.resource.data.tabLayout.get('prayerOrder', []).size() <= 20
          && request.resource.data.tabLayout.get('prayerHidden', []) is list
          && request.resource.data.tabLayout.get('prayerHidden', []).size() <= 20
          && request.resource.data.tabLayout.get('amolOrder', []) is list
          && request.resource.data.tabLayout.get('amolOrder', []).size() <= 20
          && request.resource.data.tabLayout.get('amolHidden', []) is list
          && request.resource.data.tabLayout.get('amolHidden', []).size() <= 20
          && request.resource.data.tabLayout.get('toolsOrder', []) is list
          && request.resource.data.tabLayout.get('toolsOrder', []).size() <= 20
          && request.resource.data.tabLayout.get('toolsHidden', []) is list
          && request.resource.data.tabLayout.get('toolsHidden', []).size() <= 20;

        // --- §Google-Login Identity Migration(2_4 §৪-৬, dual-path) ---
        // সম্পূর্ণ additive — উপরের ownerUids-based clause-গুলো অপরিবর্তিত।
        // এই নতুন clause-গুলো শুধু তখনই relevant যখন member doc-এ
        // email/googleUid field ব্যবহার হচ্ছে(2_4_1-এর Phase-2 data-write
        // থেকে); বাকি সব বিদ্যমান member(ownerUids-only) এই clause-গুলোর
        // কোনো শর্তই match করবে না, causing no behavior change।

        // Admin-added proxy member(unclaimed, 2_4 §৫.১) — email/googleUid:
        // null সেট করে তৈরি। affectedKeys()-এ ইতিমধ্যে-অনুমোদিত keys()-এর
        // বাইরের নতুন field হওয়ায় উপরের generic create rule(admin-only)-ই
        // যথেষ্ট, আলাদা create-clause লাগে না।

        // Admin — unclaimed proxy-র email edit/remove(§৫.১, §৫.৩ "মেইল
        // সরান")। শুধু তখনই যখন member এখনো unclaimed(googleUid অনুপস্থিত
        // বা null) — claimed member-এর email field ইতিমধ্যে delete করা
        // (§৪), তাই এই clause claimed member-এ কখনো প্রযোজ্য না।
        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && (!('googleUid' in resource.data) || resource.data.googleUid == null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'updatedAt']);

        // Admin — unclaimed proxy-র নাম/জেন্ডার edit(functional-gap fix)।
        // নতুন-schema proxy member-এ ownerUids field-ই থাকে না বলে
        // legacy ownerUids-block(admin-bypass সহ general-edit করত) এই
        // doc-shape-এর জন্য নির্ভরযোগ্য না — তাই আলাদা explicit clause,
        // legacy/google-only উভয় state-এই সচল(ownerUids-নিরপেক্ষ)।
        allow update: if request.auth != null
          && isAdminOfFamily(familyId)
          && (!('googleUid' in resource.data) || resource.data.googleUid == null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'gender', 'updatedAt']);

        // Claim(email-match auto-bind বা invite-link join, 2_4 §৫.১/§৫.২):
        // googleUid null→request.auth.uid সেট হওয়ার সাথে সাথে email field
        // remove হয়(§৪, একই write-এ) — familyMemberEmails uniqueness-doc
        // ইতিমধ্যে সংশ্লিষ্ট memberId পয়েন্ট করে বলে(অন্য কোনো path থেকে
        // এই doc তৈরি না হলে claim সম্ভবই না) forge-সুরক্ষা মূলত সেই
        // top-level collection-এর create-rule থেকেই আসে।
        //
        // §Google-Login fix(Critical #2, security-audit ৯ সেপ্টেম্বর ২০২৬):
        // আগে এখানে request.auth-এর প্রকৃত email কখনো যাচাই হতো না — শুধু
        // client দাবি করত যে সে সঠিক member match করেছে। কিন্তু
        // familyMemberEmails/{emailKey}-এর "get" যেকোনো authenticated
        // user-এর জন্য খোলা(§Google-Login Identity Migration comment
        // দ্রষ্টব্য) — অর্থাৎ কেউ target-এর email জানলে/guess করলে সেই
        // email দিয়ে normalize করে mapping doc পড়ে familyId/memberId বের
        // করে নিজের uid দিয়ে claim করে নিতে পারত(Authentication ঠিক থাকলেও
        // Authorization কখনো যাচাই হতো না — account/identity-takeover)।
        // Fix: Firebase Auth-এর server-verified ID token email claim
        // (request.auth.token.email, client দাবির উপর নির্ভরশীল নয়) এখন
        // resource-এ সংরক্ষিত normalized email-এর সাথে মিলতেই হবে। §১০.২
        // অনুযায়ী resource.data.email আগে থেকেই normalizeEmail()
        // (trim+lowercase)-প্রয়োগ করা থাকে, তাই এখানে শুধু auth-token
        // email-কে .lower() করেই তুলনা যথেষ্ট(trim দরকার নেই — Google
        // account email-এ leading/trailing space থাকে না)।
        allow update: if request.auth != null
          && (!('googleUid' in resource.data) || resource.data.googleUid == null)
          && request.resource.data.googleUid == request.auth.uid
          && !('email' in request.resource.data)
          && 'email' in resource.data
          && request.auth.token.email is string
          && request.auth.token.email.lower() == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['googleUid', 'email', 'updatedAt']);

        // Claimed member নিজে(googleUid==request.auth.uid) — profile-edit
        // (নাম/জেন্ডার, 2_5 Screen E "প্রোফাইল এডিট")। role এখানে কখনো
        // affected হতে পারবে না(উপরের top-level role-lock guard এই
        // clause-এও প্রযোজ্য, কারণ সেটা match-level AND, সব clause কভার
        // করে)।
        allow update: if request.auth != null
          && isClaimedByGoogle(familyId, memberId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'gender', 'updatedAt']);

        // Family ত্যাগ(self-leave, 2_4 §৫.৩) — claimed member নিজে নিজের
        // doc delete করতে পারবে, শুধু firstAdminUid না হলে(protection নিচের
        // family-root-এর মতোই — firstAdminUid প্রথমে admin-transfer ছাড়া
        // leave করতে পারবেন না)।
        allow delete: if request.auth != null
          && isClaimedByGoogle(familyId, memberId)
          && (
               !('firstAdminUid' in get(/databases/$(database)/documents/families/$(familyId)).data)
               || request.auth.uid != get(/databases/$(database)/documents/families/$(familyId)).data.firstAdminUid
             );
      }

      match /entries/{entryId} {
        allow read: if request.auth != null && isApprovedMember(familyId);
        allow create, update, delete: if request.auth != null
          && (isUnownedOrMineArray(currentMemberOwnerV2(familyId, entryId)) || isAdminOfFamily(familyId));
      }

      match /weekly/{weeklyId} {
        allow read: if request.auth != null && isApprovedMember(familyId);
        allow create, update, delete: if request.auth != null
          && (isUnownedOrMineArray(currentMemberOwnerV2(familyId, weeklyId)) || isAdminOfFamily(familyId));
      }

      // --- reviews: ব্যক্তিগত সাপ্তাহিক মুহাসাবা (শুধু মালিক দেখবে) ---
      // doc id: "<memberId>_<weekKey>", weekKey = সপ্তাহ-শুরুর তারিখ YYYY-MM-DD।
      // read/write/delete: শুধু ওই member-এর আসল owner uid (ownerUids বা googleUid)।
      // কোনো admin বা অন্য সদস্য পড়তে পারে না। একমাত্র ব্যতিক্রম: কেউ এখনো
      // claim করেনি এমন proxy member (googleUid == null)-এর জন্য পরিবারের admin।
      // weekly-র মতো "unowned ⇒ সবার জন্য খোলা" নীতি এখানে নেই — ফাঁকা owner = কেউ না।
      // list বন্ধ: ক্লায়েন্ট id ধরে get করে।
      function isReviewOwner(fid, reviewId) {
        let owners = currentMemberOwnerV2(fid, reviewId);
        return owners != null && owners.hasAny([request.auth.uid]);
      }
      function isUnclaimedProxyAdmin(fid, reviewId) {
        let mp = /databases/$(database)/documents/families/$(fid)/members/$(reviewId.split('_')[0]);
        return exists(mp)
          && ('googleUid' in get(mp).data)
          && get(mp).data.googleUid == null
          && isAdminOfFamily(fid);
      }
      function canAccessReview(fid, reviewId) {
        return request.auth != null
          && (isReviewOwner(fid, reviewId) || isUnclaimedProxyAdmin(fid, reviewId));
      }
      function reviewStr(d, k, max) {
        return !(k in d) || (d[k] is string && d[k].size() <= max);
      }
      function reviewList(d, k) {
        return !(k in d) || (d[k] is list && d[k].size() <= 8);
      }
      // সীমা src/legacy/reviewSchema.js-এর LIMITS-এর সাথে মেলে। "বদ্ধ ঘর" ফিল্ড whitelist-এ নেই।
      function validReview(reviewId) {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'memberId', 'weekKey', 'updatedAt', 'step', 'done', 'goalResult',
                                 'goalText', 'hardMoment', 'nextGoal', 'ifText', 'thenText', 'gratitude', 'gapKey',
                                 'blockers', 'gapReasons', 'haqq'])
          && d.keys().hasAll(['v', 'memberId', 'weekKey', 'updatedAt'])
          && d.v == 1
          && d.memberId is string
          && d.weekKey is string
          && d.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && reviewId == d.memberId + '_' + d.weekKey
          && d.updatedAt is number
          && (!('step' in d) || (d.step is int && d.step >= 1 && d.step <= 5))
          && (!('done' in d) || d.done is bool)
          && (!('goalResult' in d) || d.goalResult in ['done', 'partial', 'none'])
          && reviewStr(d, 'goalText', 200)
          && reviewStr(d, 'hardMoment', 300)
          && reviewStr(d, 'nextGoal', 200)
          && reviewStr(d, 'ifText', 200)
          && reviewStr(d, 'thenText', 200)
          && reviewStr(d, 'gratitude', 300)
          && reviewStr(d, 'gapKey', 40)
          && reviewList(d, 'blockers')
          && reviewList(d, 'gapReasons')
          && reviewList(d, 'haqq');
      }

      match /reviews/{reviewId} {
        allow get: if canAccessReview(familyId, reviewId);
        allow list: if false;
        allow create, update: if canAccessReview(familyId, reviewId) && validReview(reviewId);
        allow delete: if canAccessReview(familyId, reviewId);
      }

      // --- §Notification System(নতুন) ---
      // সাধারণ, extensible in-app notification framework(শুরুতে শুধু
      // "admin_assigned" type)। শুধু নিজের(targetUid-matched) notification
      // পড়া/read-mark করা যায়; create শুধু admin করতে পারবে(এই মুহূর্তে
      // handleMakeAdmin() থেকে) — future-এ অন্য admin action-ও এই একই
      // collection ব্যবহার করতে পারবে কোনো Rules পরিবর্তন ছাড়াই।
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.targetUid;
        // "device_joined"(নতুন, ১৫ আগস্ট ২০২৬, Option A auto-approve-এর
        // সাথে যোগ): নতুন self-approved(non-admin) member-ও admin-কে
        // notify করতে পারবে — কিন্তু শুধু এই নির্দিষ্ট type-এ, শুধু
        // approved member হলে, এবং targetUid অবশ্যই family-র প্রকৃত admin
        // হতে হবে(resource.data.adminUids থেকে verify, forge করা যাবে না)।
        // admin_assigned-এর পুরনো path(শুধু admin) অপরিবর্তিত।
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['targetUid', 'type', 'message', 'createdAt', 'read'])
          && request.resource.data.targetUid is string
          && request.resource.data.type is string
          && request.resource.data.message is string
          && request.resource.data.read == false
          && (
               (request.resource.data.type == 'admin_assigned' && isAdminOfFamily(familyId))
               || (request.resource.data.type == 'device_joined'
                   && isApprovedMember(familyId)
                   && get(/databases/$(database)/documents/families/$(familyId)).data.adminUids.hasAny([request.resource.data.targetUid]))
             );
        allow update: if request.auth != null
          && request.auth.uid == resource.data.targetUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if request.auth != null && request.auth.uid == resource.data.targetUid;
      }

      // --- §Recovery Key(First Admin) — hidden hash storage ---
      // Plaintext key কখনো Firestore-এ যায় না(client-side generate+hash)।
      // এই doc client থেকে কখনো read করা যায় না(শুধু Rules-এর ভেতরে get()
      // দিয়ে hash compare করার জন্য ব্যবহৃত) — তাই hash কখনো leak হয় না।
      // একবার সেট হলে immutable(update/delete সম্পূর্ণ বন্ধ) — rotation
      // future scope, এখন প্রয়োজন নেই।
      match /private/{docId} {
        allow read: if false;
        allow create: if request.auth != null
          && isAdminOfFamily(familyId)
          && docId == 'recovery'
          && request.resource.data.keys().hasOnly(['hash', 'createdAt'])
          && request.resource.data.hash is string
          && request.resource.data.hash.size() == 64;
        allow update, delete: if false;
      }
    }

    // --- legacy data_<code> কালেকশন (appStorage shared ডক) ---
    // এখানে থাকে: মাসিক সভা (meeting_rows_v2:YYYY-MM), custom_fields, field_overrides,
    // tazkirah_custom। আগে এই কালেকশনের কোনো match ছিল না ⇒ default-deny ⇒ সভা সেভে
    // "Missing or insufficient permissions"। পরিবার চেনা হয় legacyCollectionMap/{নাম}.familyId
    // থেকে (map না থাকলে অস্বীকৃত); অ্যাক্সেস = isApprovedMember (admin/creator/claimed সদস্য)।
    // Read-এ ডক-id সীমা নেই (backup পুরো কালেকশন list করে); Write-এ id whitelist + আকার-সীমা।
    match /{legacyCol}/{legacyDocId} {
      function legacyMapPath() {
        return /databases/$(database)/documents/legacyCollectionMap/$(legacyCol);
      }
      function legacyAccess() {
        return request.auth != null
          && legacyCol.matches('data_.*')
          && exists(legacyMapPath())
          && isApprovedMember(get(legacyMapPath()).data.familyId);
      }
      allow read: if legacyAccess();
      allow create, update: if legacyAccess()
        && legacyDocId.matches('meeting_rows_v2:[0-9]{4}-[0-9]{2}|custom_fields|field_overrides|tazkirah_custom')
        && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 200000;
      allow delete: if legacyAccess()
        && isAdminOfFamily(get(legacyMapPath()).data.familyId);
    }

    // --- PWA ইনস্টল কাউন্টার (গ্লোবাল, কোনো নির্দিষ্ট পরিবারের ডাটা নয়) ---
    match /app_stats/{statId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['count', 'lastInstalledAt'])
        && request.resource.data.count is number;
      allow delete: if false;
    }
  }
}
