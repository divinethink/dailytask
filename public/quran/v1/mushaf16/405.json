{"v":1,"p":405,"l":[["a",0,[[37,93,"ضَرْبًاۢ بِالْيَمِيْنِ ۝٩٣"],[37,94,"فَاَقْبَلُوْٓا اِلَيْهِ يَزِفُّوْنَ ۝٩٤"],[37,95,"قَالَ اَتَعْبُدُوْنَ مَا"]]],["a",0,[[37,95,"تَنْحِتُوْنَ ۝٩٥ۙ"],[37,96,"وَاللّٰهُ خَلَقَكُمْ وَمَا تَعْمَلُوْنَ ۝٩٦"],[37,97,"قَالُوا ابْنُوْا لَهٗ بُنْيَانًا"]]],["a",0,[[37,97,"فَاَلْقُوْهُ فِي الْجَحِيْمِ ۝٩٧"],[37,98,"فَاَرَادُوْا بِهٖ كَيْدًا فَجَعَلْنٰهُمُ الْاَسْفَلِيْنَ ۝٩٨"]]],["a",0,[[37,99,"وَقَالَ اِنِّيْ ذَاهِبٌ اِلٰي رَبِّيْ سَيَهْدِيْنِ ۝٩٩"],[37,100,"رَبِّ هَبْ لِيْ مِنَ"]]],["a",0,[[37,100,"الصّٰلِحِيْنَ ۝١٠٠"],[37,101,"فَبَشَّرْنٰهُ بِغُلٰمٍ حَلِيْمٍ ۝١٠١"],[37,102,"فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ قَالَ"]]],["a",0,[[37,102,"يٰبُنَيَّ اِنِّيْٓ اَرٰي فِي الْمَنَامِ اَنِّيْٓ اَذْبَحُكَ فَانْظُرْ مَاذَا تَرٰيؕ قَالَ"]]],["a",0,[[37,102,"يٰٓاَبَتِ افْعَلْ مَا تُو͏ٔ͏ْمَرُؗ سَتَجِدُنِيْٓ اِنْ شَا࢜ءَ اللّٰهُ مِنَ الصّٰبِرِيْنَ ۝١٠٢"]]],["a",0,[[37,103,"فَلَمَّا͏ٓ اَسْلَمَا وَتَلَّهٗ لِلْجَبِيْنِ ۝١٠٣ۚ"],[37,104,"وَنَادَيْنٰهُ اَنْ يّٰٓاِبْرٰهِيْمُ ۝١٠٤ۙ"],[37,105,"قَدْ"]]],["a",0,[[37,105,"صَدَّقْتَ الرُّءْيَاۚ اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ ۝١٠٥"],[37,106,"اِنَّ هٰذَا لَهُوَ"]]],["a",0,[[37,106,"الْبَلٰ࢜و͏ٔ͏ُا الْمُبِيْنُ ۝١٠٦"],[37,107,"وَفَدَيْنٰهُ بِذِبْحٍ عَظِيْمٍ ۝١٠٧"],[37,108,"وَتَرَكْنَا عَلَيْهِ فِي"]]],["a",0,[[37,108,"الْاٰخِرِيْنَ ۝١٠٨ۖ"],[37,109,"سَلٰمٌ عَلٰٓي اِبْرٰهِيْمَ ۝١٠٩"],[37,110,"كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ ۝١١٠"]]],["a",0,[[37,111,"اِنَّهٗ مِنْ عِبَادِنَا الْمُو͏ٔ͏ْمِنِيْنَ ۝١١١"],[37,112,"وَبَشَّرْنٰهُ بِاِسْحٰقَ نَبِيًّا مِّنَ"]]],["a",0,[[37,112,"الصّٰلِحِيْنَ ۝١١٢"],[37,113,"وَبٰرَكْنَا عَلَيْهِ وَعَلٰٓي اِسْحٰقَؕ وَمِنْ ذُرِّيَّتِهِمَا مُحْسِنٌ"]]],["a",0,[[37,113,"وَّظَالِمٌ لِّنَفْسِهٖ مُبِيْنٌ ۝١١٣ࣖ"],[37,114,"وَلَقَدْ مَنَنَّا عَلٰي مُوْسٰي وَهٰرُوْنَ ۝١١٤ۚ"]]],["a",0,[[37,115,"وَنَجَّيْنٰهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظِيْمِ ۝١١٥ۚ"],[37,116,"وَنَصَرْنٰهُمْ فَكَانُوْا"]]],["a",0,[[37,116,"هُمُ الْغٰلِبِيْنَ ۝١١٦ۚ"],[37,117,"وَاٰتَيْنٰهُمَا الْكِتٰبَ الْمُسْتَبِيْنَ ۝١١٧ۚ"],[37,118,"وَهَدَيْنٰهُمَا"]]]]}