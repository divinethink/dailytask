{"v":1,"p":338,"l":[["a",0,[[26,190,"اِنَّ فِيْ ذٰلِكَ لَاٰيَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُّو͏ٔ͏ْمِنِيْنَ ۝١٩٠"],[26,191,"وَاِنَّ رَبَّكَ"]]],["a",0,[[26,191,"لَهُوَ الْعَزِيْزُ الرَّحِيْمُ ۝١٩١ࣖ"],[26,192,"وَاِنَّهٗ لَتَنْزِيْلُ رَبِّ الْعٰلَمِيْنَ ۝١٩٢ؕ"],[26,193,"نَزَلَ بِهِ"]]],["a",0,[[26,193,"الرُّوْحُ الْاَمِيْنُ ۝١٩٣ۙ"],[26,194,"عَلٰي قَلْبِكَ لِتَكُوْنَ مِنَ الْمُنْذِرِيْنَ ۝١٩٤ۙ"],[26,195,"بِلِسَانٍ"]]],["a",0,[[26,195,"عَرَبِيٍّ مُّبِيْنٍ ۝١٩٥ؕ"],[26,196,"وَاِنَّهٗ لَفِيْ زُبُرِ الْاَوَّلِيْنَ ۝١٩٦"],[26,197,"اَوَلَمْ يَكُنْ لَّهُمْ اٰيَةً"]]],["a",0,[[26,197,"اَنْ يَّعْلَمَهٗ عُلَمٰ࢜و͏ٔ͏ُا بَنِيْٓ اِسْرَا࢜ءِيْلَ ۝١٩٧ؕ"],[26,198,"وَلَوْ نَزَّلْنٰهُ عَلٰي بَعْضِ"]]],["a",0,[[26,198,"الْاَعْجَمِيْنَ ۝١٩٨ۙ"],[26,199,"فَقَرَاَهٗ عَلَيْهِمْ مَّا كَانُوْا بِهٖ مُو͏ٔ͏ْمِنِيْنَ ۝١٩٩ؕ"],[26,200,"كَذٰلِكَ سَلَكْنٰهُ"]]],["a",0,[[26,200,"فِيْ قُلُوْبِ الْمُجْرِمِيْنَ ۝٢٠٠ؕ"],[26,201,"لَا يُو͏ٔ͏ْمِنُوْنَ بِهٖ حَتّٰي يَرَوُا الْعَذَابَ الْاَلِيْمَ ۝٢٠١ۙ"]]],["a",0,[[26,202,"فَيَاْتِيَهُمْ بَغْتَةً وَّهُمْ لَا يَشْعُرُوْنَ ۝٢٠٢ۙ"],[26,203,"فَيَقُوْلُوْا هَلْ نَحْنُ مُنْظَرُوْنَ ۝٢٠٣ؕ"]]],["a",0,[[26,204,"اَفَبِعَذَابِنَا يَسْتَعْجِلُوْنَ ۝٢٠٤"],[26,205,"اَفَرَءَيْتَ اِنْ مَّتَّعْنٰهُمْ سِنِيْنَ ۝٢٠٥ۙ"],[26,206,"ثُمَّ جَا࢜ءَهُمْ"]]],["a",0,[[26,206,"مَّا كَانُوْا يُوْعَدُوْنَ ۝٢٠٦ۙ"],[26,207,"مَا͏ٓ اَغْنٰي عَنْهُمْ مَّا كَانُوْا يُمَتَّعُوْنَ ۝٢٠٧ؕ"],[26,208,"وَمَا͏ٓ اَهْلَكْنَا"]]],["a",0,[[26,208,"مِنْ قَرْيَةٍ اِلَّا لَهَا مُنْذِرُوْنَ ۝٢٠٨ࣗۖۛ"],[26,209,"ذِكْرٰيࣞۛ وَمَا كُنَّا ظٰلِمِيْنَ ۝٢٠٩"],[26,210,"وَمَا"]]],["a",0,[[26,210,"تَنَزَّلَتْ بِهِ الشَّيٰطِيْنُ ۝٢١٠"],[26,211,"وَمَا يَنۢ͏ْبَغِيْ لَهُمْ وَمَا يَسْتَطِيْعُوْنَ ۝٢١١ؕ"],[26,212,"اِنَّهُمْ"]]],["a",0,[[26,212,"عَنِ السَّمْعِ لَمَعْزُوْلُوْنَ ۝٢١٢ؕ"],[26,213,"فَلَا تَدْعُ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَتَكُوْنَ"]]],["a",0,[[26,213,"مِنَ الْمُعَذَّبِيْنَ ۝٢١٣ۚ"],[26,214,"وَاَنْذِرْ عَشِيْرَتَكَ الْاَقْرَبِيْنَ ۝٢١٤ۙ"],[26,215,"وَاخْفِضْ"]]],["a",0,[[26,215,"جَنَاحَكَ لِمَنِ اتَّبَعَكَ مِنَ الْمُو͏ٔ͏ْمِنِيْنَ