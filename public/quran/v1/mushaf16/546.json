{"v":1,"p":546,"l":[["s",105],["a",0,[[105,1,"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِاَصْحٰبِ الْفِيْلِ ۝١ؕ"],[105,2,"اَلَمْ يَجْعَلْ كَيْدَهُمْ"]]],["a",0,[[105,2,"فِيْ تَضْلِيْلٍ ۝٢ۙ"],[105,3,"وَّاَرْسَلَ عَلَيْهِمْ طَيْرًا اَبَابِيْلَ ۝٣ۙ"],[105,4,"تَرْمِيْهِمْ"]]],["a",1,[[105,4,"بِحِجَارَةٍ مِّنْ سِجِّيْلٍ ۝٤ࣕۙ"],[105,5,"فَجَعَلَهُمْ كَعَصْفٍ مَّاْكُوْلٍ ۝٥ࣖ"]]],["s",106],["a",0,[[106,1,"لِاِيْلٰفِ قُرَيْشٍ ۝١ۙ"],[106,2,"اٖلٰفِهِمْ رِحْلَةَ الشِّتَا࢜ءِ وَالصَّيْفِ ۝٢ۚ"]]],["a",0,[[106,3,"فَلْيَعْبُدُوْا رَبَّ هٰذَا الْبَيْتِ ۝٣ۙ"],[106,4,"الَّذِيْٓ اَطْعَمَهُمْ مِّنْ جُوْعٍ࣢ۙ"]]],["a",1,[[106,4,"وَّاٰمَنَهُمْ مِّنْ خَوْفٍ ۝٤ࣖ"]]],["s",107],["a",0,[[107,1,"اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِ ۝١ؕ"],[107,2,"فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَ ۝٢ۙ"]]],["a",0,[[107,3,"وَلَا يَحُضُّ عَلٰي طَعَامِ الْمِسْكِيْنِ ۝٣ؕ"],[107,4,"فَوَيْلٌ لِّلْمُصَلِّيْنَ ۝٤ۙ"]]],["a",0,[[107,5,"الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَ ۝٥ۙ"],[107,6,"الَّذِيْنَ هُمْ يُرَا࢜ءُوْنَ ۝٦ۙ"]]],["a",1,[[107,7,"وَيَمْنَعُوْنَ الْمَاعُوْنَ ۝٧ࣖ"]]],["s",108],["a",0,[[108,1,"اِنَّا͏ٓ اَعْطَيْنٰكَ الْكَوْثَرَ ۝١ؕ"],[108,2,"فَصَلِّ لِرَبِّكَ وَانْحَرْ ۝٢ؕ"],[108,3,"اِنَّ"]]],["a",1,[[108,3,"شَانِي͏ٔ͏َكَ هُوَ الْاَبْتَرُ ۝٣ࣖ"]]]]}