{"v":1,"p":148,"l":[["a",0,[[7,108,"وَّنَزَعَ يَدَهٗ فَاِذَا هِيَ بَيْضَا࢜ءُ لِلنّٰظِرِيْنَ ۝١٠٨ࣖ"],[7,109,"قَالَ الْمَلَاُ مِنْ قَوْمِ"]]],["a",0,[[7,109,"فِرْعَوْنَ اِنَّ هٰذَا لَسٰحِرٌ عَلِيْمٌ ۝١٠٩ۙ"],[7,110,"يُّرِيْدُ اَنْ يُّخْرِجَكُمْ مِّنْ"]]],["a",0,[[7,110,"اَرْضِكُمْۚ فَمَاذَا تَاْمُرُوْنَ ۝١١٠"],[7,111,"قَالُوْٓا اَرْجِهْ وَاَخَاهُ وَاَرْسِلْ فِي"]]],["a",0,[[7,111,"الْمَدَا࢜ىِٕنِ حٰشِرِيْنَ ۝١١١ۙ"],[7,112,"يَاْتُوْكَ بِكُلِّ سٰحِرٍ عَلِيْمٍ ۝١١٢"],[7,113,"وَجَا࢜ءَ السَّحَرَةُ"]]],["a",0,[[7,113,"فِرْعَوْنَ قَالُوْٓا اِنَّ لَنَا لَاَجْرًا اِنْ كُنَّا نَحْنُ الْغٰلِبِيْنَ ۝١١٣"],[7,114,"قَالَ نَعَمْ"]]],["a",0,[[7,114,"وَاِنَّكُمْ لَمِنَ الْمُقَرَّبِيْنَ ۝١١٤"],[7,115,"قَالُوْا يٰمُوْسٰٓي اِمَّا͏ٓ اَنْ تُلْقِيَ وَاِمَّا͏ٓ"]]],["a",0,[[7,115,"اَنْ نَّكُوْنَ نَحْنُ الْمُلْقِيْنَ ۝١١٥"],[7,116,"قَالَ اَلْقُوْاۚ فَلَمَّا͏ٓ اَلْقَوْا سَحَرُوْٓا اَعْيُنَ"]]],["a",0,[[7,116,"النَّاسِ وَاسْتَرْهَبُوْهُمْ وَجَا࢜ءُوْ بِسِحْرٍ عَظِيْمٍ ۝١١٦"],[7,117,"وَاَوْحَيْنَا͏ٓ اِلٰي"]]],["a",0,[[7,117,"مُوْسٰٓي اَنْ اَلْقِ عَصَاكَۚ فَاِذَا هِيَ تَلْقَفُ مَا يَاْفِكُوْنَ ۝١١٧ۚ"],[7,118,"فَوَقَعَ"]]],["a",0,[[7,118,"الْحَقُّ وَبَطَلَ مَا كَانُوْا يَعْمَلُوْنَ ۝١١٨ۚ"],[7,119,"فَغُلِبُوْا هُنَالِكَ وَانْقَلَبُوْا"]]],["a",0,[[7,119,"صٰغِرِيْنَ ۝١١٩ۚ"],[7,120,"وَاُلْقِيَ السَّحَرَةُ سٰجِدِيْنَ ۝١٢٠ۚۖ"],[7,121,"قَالُوْٓا اٰمَنَّا بِرَبِّ الْعٰلَمِيْنَ ۝١٢١ۙ"]]],["a",0,[[7,122,"رَبِّ مُوْسٰي وَهٰرُوْنَ ۝١٢٢"],[7,123,"قَالَ فِرْعَوْنُ اٰمَنْتُمْ بِهٖ قَبْلَ اَنْ"]]],["a",0,[[7,123,"اٰذَنَ لَكُمْۚ اِنَّ هٰذَا لَمَكْرٌ مَّكَرْتُمُوْهُ فِي الْمَدِيْنَةِ لِتُخْرِجُوْا مِنْهَا͏ٓ"]]],["a",0,[[7,123,"اَهْلَهَاۚ فَسَوْفَ تَعْلَمُوْنَ ۝١٢٣"],[7,124,"لَاُقَطِّعَنَّ اَيْدِيَكُمْ وَاَرْجُلَكُمْ"]]],["a",0,[[7,124,"مِّنْ خِلَافٍ ثُمَّ لَاُصَلِّبَنَّكُمْ اَجْمَعِيْنَ ۝١٢٤"],[7,125,"قَالُوْٓا اِنَّا͏ٓ اِلٰي رَبِّنَا"]]],["a",0,[[7,125,"مُنْقَلِبُوْنَ ۝١٢٥ۚ"],[7,126,"وَمَا تَنْقِمُ مِنَّا͏ٓ اِلَّا͏ٓ اَنْ اٰمَنَّا بِاٰيٰتِ رَبِّنَا لَمَّا جَا࢜ءَتْنَاؕ"]]]]}