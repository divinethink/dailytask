{"v":1,"p":536,"l":[["a",0,[[85,10,"اِنَّ الَّذِيْنَ فَتَنُوا الْمُو͏ٔ͏ْمِنِيْنَ وَالْمُو͏ٔ͏ْمِنٰتِ ثُمَّ لَمْ يَتُوْبُوْا فَلَهُمْ"]]],["a",0,[[85,10,"عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيْقِ ۝١٠ؕ"],[85,11,"اِنَّ الَّذِيْنَ اٰمَنُوْا"]]],["a",0,[[85,11,"وَعَمِلُوا الصّٰلِحٰتِ لَهُمْ جَنّٰتٌ تَجْرِيْ مِنْ تَحْتِهَا الْاَنْهٰرُ࣢ؕؔ ذٰلِكَ"]]],["a",0,[[85,11,"الْفَوْزُ الْكَبِيْرُ ۝١١ؕ"],[85,12,"اِنَّ بَطْشَ رَبِّكَ لَشَدِيْدٌ ۝١٢ؕ"],[85,13,"اِنَّهٗ هُوَ يُبْدِي͏ٔ͏ُ"]]],["a",0,[[85,13,"وَيُعِيْدُ ۝١٣ۚ"],[85,14,"وَهُوَ الْغَفُوْرُ الْوَدُوْدُ ۝١٤ۙ"],[85,15,"ذُو الْعَرْشِ الْمَجِيْدُ ۝١٥ۙ"],[85,16,"فَعَّالٌ"]]],["a",0,[[85,16,"لِّمَا يُرِيْدُ ۝١٦ؕ"],[85,17,"هَلْ اَتٰىكَ حَدِيْثُ الْجُنُوْدِ ۝١٧ۙ"],[85,18,"فِرْعَوْنَ وَثَمُوْدَ ۝١٨ؕ"]]],["a",0,[[85,19,"بَلِ الَّذِيْنَ كَفَرُوْا فِيْ تَكْذِيْبٍ ۝١٩ۙ"],[85,20,"وَّاللّٰهُ مِنْ وَّرَا࢜ىِٕهِمْ مُّحِيْطٌ ۝٢٠ۚ"]]],["a",1,[[85,21,"بَلْ هُوَ قُرْاٰنٌ مَّجِيْدٌ ۝٢١ۙ"],[85,22,"فِيْ لَوْحٍ مَّحْفُوْظٍ ۝٢٢ࣖ"]]],["s",86],["a",0,[[86,1,"وَالسَّمَا࢜ءِ وَالطَّارِقِ ۝١ۙ"],[86,2,"وَمَا͏ٓ اَدْرٰىكَ مَا الطَّارِقُ ۝٢ۙ"],[86,3,"النَّجْمُ الثَّاقِبُ ۝٣ۙ"]]],["a",0,[[86,4,"اِنْ كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ ۝٤ؕ"],[86,5,"فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَ ۝٥ؕ"]]],["a",0,[[86,6,"خُلِقَ مِنْ مَّا࢜ءٍ دَافِقٍ ۝٦ۙ"],[86,7,"يَّخْرُجُ مِنْۢ بَيْنِ الصُّلْبِ وَالتَّرَا࢜ىِٕبِ ۝٧ؕ"]]],["a",0,[[86,8,"اِنَّهٗ عَلٰي رَجْعِهٖ لَقَادِرٌ ۝٨ؕ"],[86,9,"يَوْمَ تُبْلَي السَّرَا࢜ىِٕرُ ۝٩ۙ"],[86,10,"فَمَا لَهٗ مِنْ قُوَّةٍ"]]],["a",0,[[86,10,"وَّلَا نَاصِرٍ ۝١٠ؕ"],[86,11,"وَالسَّمَا࢜ءِ ذَاتِ الرَّجْعِ ۝١١ۙ"],[86,12,"وَالْاَرْضِ ذَاتِ الصَّدْعِ ۝١٢ۙ"]]],["a",0,[[86,13,"اِنَّهٗ لَقَوْلٌ فَصْلٌ ۝١٣ۙ"],[86,14,"وَّمَا هُوَ بِالْهَزْلِ ۝١٤ؕ"],[86,15,"اِنَّهُمْ يَكِيْدُوْنَ كَيْدًا ۝١٥ۙ"]]],["a",1,[[86,16,"وَّاَكِيْدُ كَيْدًا ۝١٦ۚۖ"],[86,17,"فَمَهِّلِ الْكٰفِرِيْنَ اَمْهِلْهُمْ رُوَيْدًا ۝١٧ࣖ"]]]]}