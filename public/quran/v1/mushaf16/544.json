{"v":1,"p":544,"l":[["s",99],["a",0,[[99,1,"اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَا ۝١ۙ"],[99,2,"وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَا ۝٢ۙ"]]],["a",0,[[99,3,"وَقَالَ الْاِنْسَانُ مَا لَهَا ۝٣ۚ"],[99,4,"يَوْمَىِٕذٍ تُحَدِّثُ اَخْبَارَهَا ۝٤ؕ"],[99,5,"بِاَنَّ"]]],["a",0,[[99,5,"رَبَّكَ اَوْحٰي لَهَا ۝٥ؕ"],[99,6,"يَوْمَىِٕذٍ يَّصْدُرُ النَّاسُ اَشْتَاتًا࣢ۙ لِّيُرَوْا"]]],["a",0,[[99,6,"اَعْمَالَهُمْ ۝٦ؕ"],[99,7,"فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَّرَهٗ ۝٧ؕ"],[99,8,"وَمَنْ"]]],["a",1,[[99,8,"يَّعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَّرَهٗ ۝٨ࣖ"]]],["s",100],["a",0,[[100,1,"وَالْعٰدِيٰتِ ضَبْحًا ۝١ۙ"],[100,2,"فَالْمُوْرِيٰتِ قَدْحًا ۝٢ۙ"],[100,3,"فَالْمُغِيْرٰتِ صُبْحًا ۝٣ۙ"]]],["a",0,[[100,4,"فَاَثَرْنَ بِهٖ نَقْعًا ۝٤ۙ"],[100,5,"فَوَسَطْنَ بِهٖ جَمْعًا ۝٥ۙ"],[100,6,"اِنَّ الْاِنْسَانَ لِرَبِّهٖ"]]],["a",0,[[100,6,"لَكَنُوْدٌ ۝٦ۚ"],[100,7,"وَاِنَّهٗ عَلٰي ذٰلِكَ لَشَهِيْدٌ ۝٧ۚ"],[100,8,"وَاِنَّهٗ لِحُبِّ الْخَيْرِ لَشَدِيْدٌ ۝٨ؕ"]]],["a",0,[[100,9,"اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِي الْقُبُوْرِ ۝٩ۙ"],[100,10,"وَحُصِّلَ مَا فِي الصُّدُوْرِ ۝١٠ۙ"]]],["a",1,[[100,11,"اِنَّ رَبَّهُمْ بِهِمْ يَوْمَىِٕذٍ لَّخَبِيْرٌ ۝١١ࣖ"]]],["s",101],["a",0,[[101,1,"اَلْقَارِعَةُ ۝١ۙ"],[101,2,"مَا الْقَارِعَةُ ۝٢ۚ"],[101,3,"وَمَا͏ٓ اَدْرٰىكَ مَا الْقَارِعَةُ ۝٣ؕ"],[101,4,"يَوْمَ"]]],["a",0,[[101,4,"يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِ ۝٤ۙ"],[101,5,"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ"]]],["a",0,[[101,5,"الْمَنْفُوْشِ ۝٥ؕ"],[101,6,"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗ ۝٦ۙ"],[101,7,"فَهُوَ فِيْ عِيْشَةٍ"]]]]}