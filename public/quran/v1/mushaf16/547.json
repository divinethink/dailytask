{"v":1,"p":547,"l":[["s",109],["a",0,[[109,1,"قُلْ يٰٓاَيُّهَا الْكٰفِرُوْنَ ۝١ۙ"],[109,2,"لَا͏ٓ اَعْبُدُ مَا تَعْبُدُوْنَ ۝٢ۙ"],[109,3,"وَلَا͏ٓ اَنْتُمْ"]]],["a",0,[[109,3,"عٰبِدُوْنَ مَا͏ٓ اَعْبُدُ ۝٣ۚ"],[109,4,"وَلَا͏ٓ اَنَا عَابِدٌ مَّا عَبَدْتُّمْ ۝٤ۙ"],[109,5,"وَلَا͏ٓ اَنْتُمْ"]]],["a",1,[[109,5,"عٰبِدُوْنَ مَا͏ٓ اَعْبُدُ ۝٥ؕ"],[109,6,"لَكُمْ دِيْنُكُمْ وَلِيَ دِيْنِ ۝٦ࣖ"]]],["s",110],["b"],["a",0,[[110,1,"اِذَا جَا࢜ءَ نَصْرُ اللّٰهِ وَالْفَتْحُ ۝١ۙ"],[110,2,"وَرَاَيْتَ النَّاسَ يَدْخُلُوْنَ فِيْ دِيْنِ"]]],["a",0,[[110,2,"اللّٰهِ اَفْوَاجًا ۝٢ۙ"],[110,3,"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُؕؔ اِنَّهٗ كَانَ تَوَّابًا ۝٣ࣖ"]]],["s",111],["b"],["a",0,[[111,1,"تَبَّتْ يَدَا͏ٓ اَبِيْ لَهَبٍ وَّتَبَّ ۝١ؕ"],[111,2,"مَا͏ٓ اَغْنٰي عَنْهُ مَالُهٗ وَمَا كَسَبَ ۝٢ؕ"]]],["a",0,[[111,3,"سَيَصْلٰي نَارًا ذَاتَ لَهَبٍ ۝٣ۚۖ"],[111,4,"وَّامْرَاَتُهٗؕ حَمَّالَةَ الْحَطَبِ ۝٤ۚ"]]],["a",1,[[111,5,"فِيْ جِيْدِهَا حَبْلٌ مِّنْ مَّسَدٍ ۝٥ࣖ"]]],["s",112],["a",0,[[112,1,"قُلْ هُوَ اللّٰهُ اَحَدٌ ۝١ۚ"],[112,2,"اَللّٰهُ الصَّمَدُ ۝٢ۚ"],[112,3,"لَمْ يَلِدْ࣢ۙ وَلَمْ يُوْلَدْ ۝٣ۙ"]]],["a",1,[[112,4,"وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ ۝٤ࣖ"]]]]}