{"v":1,"p":473,"l":[["a",0,[[52,40,"فَهُمْ مِّنْ مَّغْرَمٍ مُّثْقَلُوْنَ ۝٤٠ؕ"],[52,41,"اَمْ عِنْدَهُمُ الْغَيْبُ فَهُمْ يَكْتُبُوْنَ ۝٤١ؕ"]]],["a",0,[[52,42,"اَمْ يُرِيْدُوْنَ كَيْدًاؕ فَالَّذِيْنَ كَفَرُوْا هُمُ الْمَكِيْدُوْنَ ۝٤٢ؕ"],[52,43,"اَمْ لَهُمْ"]]],["a",0,[[52,43,"اِلٰهٌ غَيْرُ اللّٰهِؕ سُبْحٰنَ اللّٰهِ عَمَّا يُشْرِكُوْنَ ۝٤٣"],[52,44,"وَاِنْ يَّرَوْا كِسْفًا مِّنَ"]]],["a",0,[[52,44,"السَّمَا࢜ءِ سَاقِطًا يَّقُوْلُوْا سَحَابٌ مَّرْكُوْمٌ ۝٤٤"],[52,45,"فَذَرْهُمْ حَتّٰي يُلٰقُوْا يَوْمَهُمُ"]]],["a",0,[[52,45,"الَّذِيْ فِيْهِ يُصْعَقُوْنَ ۝٤٥ۙ"],[52,46,"يَوْمَ لَا يُغْنِيْ عَنْهُمْ كَيْدُهُمْ شَيْـًٔا وَّلَا هُمْ"]]],["a",0,[[52,46,"يُنْصَرُوْنَ ۝٤٦ؕ"],[52,47,"وَاِنَّ لِلَّذِيْنَ ظَلَمُوْا عَذَابًا دُوْنَ ذٰلِكَ وَلٰكِنَّ اَكْثَرَهُمْ"]]],["a",0,[[52,47,"لَا يَعْلَمُوْنَ ۝٤٧"],[52,48,"وَاصْبِرْ لِحُكْمِ رَبِّكَ فَاِنَّكَ بِاَعْيُنِنَا وَسَبِّحْ بِحَمْدِ رَبِّكَ"]]],["a",1,[[52,48,"حِيْنَ تَقُوْمُ ۝٤٨ۙ"],[52,49,"وَمِنَ الَّيْلِ فَسَبِّحْهُ وَاِدْبَارَ النُّجُوْمِ ۝٤٩ࣖ"]]],["s",53],["a",0,[[53,1,"وَالنَّجْمِ اِذَا هَوٰي ۝١ۙ"],[53,2,"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوٰي ۝٢ۚ"],[53,3,"وَمَا يَنْطِقُ عَنِ"]]],["a",0,[[53,3,"الْهَوٰي ۝٣ؕ"],[53,4,"اِنْ هُوَ اِلَّا وَحْيٌ يُّوْحٰي ۝٤ۙ"],[53,5,"عَلَّمَهٗ شَدِيْدُ الْقُوٰي ۝٥ۙ"],[53,6,"ذُوْ مِرَّةٍؕ"]]],["a",0,[[53,6,"فَاسْتَوٰي ۝٦ۙ"],[53,7,"وَهُوَ بِالْاُفُقِ الْاَعْلٰي ۝٧ؕ"],[53,8,"ثُمَّ دَنَا فَتَدَلّٰي ۝٨ۙ"],[53,9,"فَكَانَ قَابَ"]]],["a",0,[[53,9,"قَوْسَيْنِ اَوْ اَدْنٰي ۝٩ۚ"],[53,10,"فَاَوْحٰٓي اِلٰي عَبْدِهٖ مَا͏ٓ اَوْحٰي ۝١٠ؕ"],[53,11,"مَا كَذَبَ الْفُو͏ٔ͏َادُ"]]],["a",0,[[53,11,"مَا رَاٰي ۝١١"],[53,12,"اَفَتُمٰرُوْنَهٗ عَلٰي مَا يَرٰي ۝١٢"],[53,13,"وَلَقَدْ رَاٰهُ نَزْلَةً اُخْرٰي ۝١٣ۙ"]]],["a",0,[[53,14,"عِنْدَ سِدْرَةِ الْمُنْتَهٰي ۝١٤"],[53,15,"عِنْدَهَا جَنَّةُ الْمَاْوٰي ۝١٥ؕ"],[53,16,"اِذْ يَغْشَي"]]],["a",0,[[53,16,"السِّدْرَةَ مَا يَغْشٰي ۝١٦ۙ"],[53,17,"مَا زَاغَ الْبَصَرُ وَمَا طَغٰي ۝١٧"],[53,18,"لَقَدْ رَاٰي مِنْ"]]]]}