/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com https://www.google.com https://www.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://www.google.com https://www.gstatic.com https://api.web3forms.com https://nominatim.openstreetmap.org https://api.aladhan.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://accounts.google.com https://*.firebaseapp.com https://www.google.com https://recaptcha.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com

# Vite hashed build assets: content-hash is in the file name, so a changed file gets a new URL.
# Safe to cache for 1 year. sw.js / index.html / manifest are NOT under /assets/ (unaffected).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
